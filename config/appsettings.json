{
  "version": 1,
  "app": {
    "host": "127.0.0.1",
    "port": 8080,
    "open_browser_on_start": false
  },
  "logging": {
    "level": "INFO",
    "file_path": "./logs/net-monitor.log",
    "rotate": false
  },
  "storage": {
    "database_path": "./data/net_monitor.db",
    "retention_days": 30
  },
  "targets": [
