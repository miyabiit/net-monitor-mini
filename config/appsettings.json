{
  "version": 1,
  "app": {
    "host": "127.0.0.1",
    "port": 8080,
    "open_browser_on_start": false
  },
  "logging": {
    "level": "INFO",
    "file_path": "./logs/net-monitor.log",
    "rotate": false
  },
  "storage": {
    "database_path": "./data/net_monitor.db",
    "retention_days": 30
  },
  "targets": [
    {
      "id": "local-gateway",
      "name": "Local Gateway",
      "address": "192.168.1.1",
      "enabled": true,
      "monitor_type": "ping",
      "interval_seconds": 300,
      "ping_count": 3,
      "timeout_seconds": 2,
      "tags": [
        "asiax network"
      ]
    }
  ]
}
